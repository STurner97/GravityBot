{
  "_howToEdit": [
    "Change the wording, keep the names. Run npm test before you push.",
    "{name} shows a value; \"uses\" lists the values a message may use.",
    "Text can be one string, or a list of lines joined with line breaks.",
    "An empty line \"\" at the end adds a line break after the text.",
    "Write {{ or }} for a brace. Write \\\" for a quote mark."
  ],
  "balance": {
    "own": {
      "uses": "{balance}",
      "text": "💰 You have **{balance}** credits."
    },
    "other": {
      "uses": "{userId} {balance}",
      "text": "💰 <@{userId}> has **{balance}** credits."
    },
    "invalidUser": "❌ Invalid user format. Please tag a user or use \"_all\"."
  },
  "balances": {
    "header": ["💰 **All Balances:**", "", ""],
    "item": {
      "uses": "{userId} {balance}",
      "text": ["<@{userId}>: **{balance}** credits", ""]
    },
    "empty": "💰 Everyone has the default balance (1000 credits)."
  },
  "denied": {
    "admin": "❌ You do not have permission to use this command."
  },
  "prediction": {
    "notFound": {
      "uses": "{predictionId}",
      "text": "❌ Prediction #{predictionId} not found."
    }
  },
  "bet": {
    "notFoundWithHint": {
      "uses": "{predictionId}",
      "text": "❌ Prediction #{predictionId} not found. Use `/predictions` to see active predictions."
    }
  },
  "myBets": {
    "header": ["🎲 **Your Active Bets:**", "", ""],
    "item": {
      "uses": "{predictionId} {question} {option} {amount}",
      "text": [
        "**ID {predictionId}:** {question}",
        "Your bet: **{option}** ({amount} credits)",
        "",
        ""
      ]
    },
    "empty": "🎲 You have no active bets."
  },
  "beg": {
    "tooRich": "You are too rich to beg.",
    "request": {
      "uses": "{username}",
      "text": "**{username}** is begging for credits. Click a button to donate or just laugh at them."
    }
  },
  "donate": {
    "button": {
      "uses": "{amount}",
      "one": "Donate {amount} Credit",
      "other": "Donate {amount} Credits"
    },
    "donated": {
      "uses": "{donorId} {amount} {recipientId}",
      "one": "<@{donorId}> donated **{amount}** credit to <@{recipientId}>!",
      "other": "<@{donorId}> donated **{amount}** credits to <@{recipientId}>!"
    },
    "self": "You cannot donate to yourself."
  },
  "changeBalance": {
    "set": {
      "uses": "{amount} {userId} {oldBalance} {newBalance}",
      "text": [
        "✅ set to {amount} credits for <@{userId}>'s balance.",
        "**Old balance:** {oldBalance}",
        "**New balance:** {newBalance}"
      ]
    },
    "add": {
      "uses": "{amount} {userId} {oldBalance} {newBalance}",
      "text": [
        "✅ {amount} credits added to <@{userId}>'s balance.",
        "**Old balance:** {oldBalance}",
        "**New balance:** {newBalance}"
      ]
    },
    "remove": {
      "uses": "{amount} {userId} {oldBalance} {newBalance}",
      "text": [
        "✅ {amount} credits removed from <@{userId}>'s balance.",
        "**Old balance:** {oldBalance}",
        "**New balance:** {newBalance}"
      ]
    }
  }
